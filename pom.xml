<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>academy.backend</groupId>
    <artifactId>ab-java-seminars-2026</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>advanced</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <repositories>
        <repository>
            <id>proxy-maven-central</id>
            <url>https://nexus.tcsbank.ru/repository/mvn-maven-proxy</url>
        </repository>
        <repository>
            <id>processing-release</id>
            <url>https://nexus.tcsbank.ru/repository/mvn_processing_release</url>
        </repository>
        <repository>
            <id>confluent</id>
            <url>https://nexus.tcsbank.ru/repository/mvn-confluent-proxy</url>
        </repository>
        <repository>
            <id>maven-all</id>
            <url>https://artifactory.tcsbank.ru/artifactory/maven-all</url>
        </repository>
        <repository>
            <id>maven-proxy</id>
            <url>https://artifactory.tcsbank.ru/artifactory/maven-proxy</url>
        </repository>
        <repository>
            <id>bap-artifactory</id>
            <url>https://artifactory.tcsbank.ru/artifactory/maven-releases-hosted/qa-bap</url>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>central</id>
            <url>https://nexus.tcsbank.ru/repository/mvn-maven-proxy</url>
        </pluginRepository>
        <pluginRepository>
            <id>processing-release</id>
            <url>https://nexus.tcsbank.ru/repository/mvn_processing_release</url>
        </pluginRepository>
        <pluginRepository>
            <id>maven-proxy</id>
            <url>https://artifactory.tcsbank.ru/artifactory/maven-proxy</url>
        </pluginRepository>
        <pluginRepository>
            <id>maven-all</id>
            <url>https://artifactory.tcsbank.ru/artifactory/maven-all</url>
        </pluginRepository>
    </pluginRepositories>

</project>
